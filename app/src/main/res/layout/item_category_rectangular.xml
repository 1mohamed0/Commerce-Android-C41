<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@android:color/transparent">

    <data>

        <import type="android.view.View" />

        <variable
            name="category"
            type="com.mis.route.e_commerce.domain.model.Category" />

        <variable
            name="isSelected"
            type="Boolean" />

    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="137dp"
        android:layout_height="82dp"
        android:layout_margin="2dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@{isSelected ? @color/white: @color/rv_bg}"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="0dp"
            android:paddingBottom="5dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/dragging_bar"
                android:layout_width="7dp"
                android:layout_height="0dp"
                android:src="@drawable/shape_selected_category_bar"
                android:visibility="@{isSelected ? View.VISIBLE: View.GONE}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/category_name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:fontFamily="@font/poppins_bold"
                android:gravity="start|center_vertical"
                android:paddingStart="5dp"
                android:paddingEnd="0dp"
                android:text="@{category.name}"
                android:textColor="@color/light_blue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/dragging_bar"
                tools:text="Men's Fashion" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</layout>
